# ==============================================================================
# MedRAG v2.0 Configuration Environment Template
# Institutional-Grade Clinical AI Intelligence SaaS Platform
# ==============================================================================

# System Deployment Mode (development | staging | production)
ENV=development

# Multi-Tenant & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-hex-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
PHI_HMAC_SALT=change-this-hmac-salt-for-phi-tokenization-securely

# Storage & LanceDB Engine
LANCEDB_URI=./data/lancedb
LANCEDB_TABLE_LITERATURE=clinical_literature
LANCEDB_TABLE_TIMELINES=patient_timelines
LANCEDB_TABLE_AUDIT=audit_log

# Local Models & Inference Serving Stack
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

NLI_MODEL_ID=microsoft/deberta-v3-large-mnli
NLI_DEVICE=cpu
NLI_ENTAILMENT_THRESHOLD=0.85
NLI_CONTRADICTION_THRESHOLD=0.60

# Synthesis Model (vLLM / LM Studio / Local Endpoint)
SYNTHESIS_API_BASE_URL=http://localhost:8000/v1
SYNTHESIS_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct
SYNTHESIS_API_KEY=not-needed-for-local-vllm
SYNTHESIS_TIMEOUT_SECONDS=30

# Background Worker & Redis Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
ARQ_QUEUE_NAME=medrag_jobs

# Observability & Metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json
